def process_watchlist_candidate(candidate, candles, higher_cache=None):
    """Resume a persisted trendline setup and its pending 5m confirmation."""

    if not isinstance(candidate, dict) or not isinstance(candles, list):
        return None
    if candidate.get("status") != "WATCHING":
        return None
    if candidate.get("strategy_type") != "TRENDLINE":
        return None

    timeframe = candidate.get("timeframe")
    direction = candidate.get("direction")
    symbol = candidate.get("symbol")
    interval_ms = {"15m": 900_000, "1h": 3_600_000}.get(timeframe)

    if interval_ms is None or direction not in ("LONG", "SHORT"):
        return None

    candidate_data = candidate.get("candidate_data")
    if isinstance(candidate_data, str):
        try:
            candidate_data = json.loads(candidate_data)
        except (TypeError, ValueError):
            return None
    if not isinstance(candidate_data, dict):
        return None

    ordered = contiguous_candle_suffix(candles, timeframe)
    if len(ordered) < 100:
        return None

    now_ms = int(time.time() * 1000)
    last_checked = candidate.get("last_checked_candle_time")
    checked_total = int(candidate.get("checked_candles") or 0)

    line = rebuild_watchlist_trendline(candidate_data, ordered)
    if line is None:
        return None

    pending = candidate_data.get("pending_retest")

    if not isinstance(pending, dict):
        evaluation = evaluate_watchlist_candidate(candidate, ordered)
        if not evaluation:
            return None

        last_checked = evaluation["last_checked_candle_time"]
        checked_total += int(evaluation["checked_candles"])

        retest = evaluation.get("retest")
        if retest is None:
            update_watchlist_candidate(
                candidate["setup_key"],
                {
                    "last_checked_candle_time": last_checked,
                    "checked_candles": checked_total,
                },
                expected_status="WATCHING",
            )
            return None

        candle = retest["candle"]
        pending = {
            "candle_time": int(candle["time"]),
            "close_time": int(retest["close_time"]),
            "line_price": float(retest["line_price"]),
            "distance": float(retest["distance"]),
            "atr": float(retest["atr"]),
        }
        candidate_data["pending_retest"] = pending

        saved = update_watchlist_candidate(
            candidate["setup_key"],
            {
                "candidate_data": candidate_data,
                "last_checked_candle_time": last_checked,
                "checked_candles": checked_total,
            },
            expected_status="WATCHING",
        )
        if not saved:
            return None

    try:
        retest_time = int(pending["candle_time"])
        retest_close_time = int(pending["close_time"])
        retest_line_price = float(pending["line_price"])
        retest_atr = float(pending["atr"])
    except (KeyError, TypeError, ValueError):
        candidate_data.pop("pending_retest", None)
        update_watchlist_candidate(
            candidate["setup_key"],
            {"candidate_data": candidate_data},
            expected_status="WATCHING",
        )
        return None

    # A pending retest is usable only during its original 10-minute window.
    if now_ms > retest_close_time + 600_000:
        candidate_data.pop("pending_retest", None)
        update_watchlist_candidate(
            candidate["setup_key"],
            {"candidate_data": candidate_data},
            expected_status="WATCHING",
        )
        return None

    retest_candle = next(
        (c for c in ordered if int(c["time"]) == retest_time), None
    )
    breakout_time = int(candidate["breakout_time"])
    breakout_candle = next(
        (c for c in ordered if int(c["time"]) == breakout_time), None
    )

    if retest_candle is None or breakout_candle is None:
        return None

    five_minute = confirm_five_minute(
        symbol,
        direction,
        retest_line_price,
        retest_atr,
        not_before_time=retest_close_time,
        not_after_time=retest_close_time + 600_000,
        timeframe=timeframe,
    )

    if five_minute is None:
        return None

    breakout_meta = candidate_data.get("breakout") or {}
    breakout = {
        "candle": breakout_candle,
        "price": float(
            breakout_meta.get("price", candidate["breakout_price"])
        ),
        "score": int(breakout_meta.get("score", 0)),
        "volume_ratio": breakout_meta.get(
            "volume_ratio", candidate.get("volume_ratio")
        ),
        "body_ratio": float(breakout_meta.get("body_ratio") or 0),
        "touches": int(line.get("touches") or len(line.get("points", []))),
    }

    retest = {
        "confirmed": True,
        "index": next(
            i for i, c in enumerate(ordered)
            if int(c["time"]) == retest_time
        ),
        "candle": retest_candle,
        "line_price": retest_line_price,
        "distance": float(pending.get("distance", 0)),
        "atr": retest_atr,
    }

    if higher_cache is None:
        higher_cache = {"candles": None}

    signal = finalize_confirmed_setup(
        symbol=symbol,
        timeframe=timeframe,
        direction=direction,
        candles=ordered,
        line=line,
        breakout=breakout,
        retest=retest,
        five_minute=five_minute,
        prefix_atr=float(
            candidate_data.get("atr_at_detection")
            or candidate.get("atr")
            or retest_atr
        ),
        higher_cache=higher_cache,
    )

    # This retest has been consumed, whether or not final filters accept it.
    candidate_data.pop("pending_retest", None)

    if signal is None:
        update_watchlist_candidate(
            candidate["setup_key"],
            {"candidate_data": candidate_data},
            expected_status="WATCHING",
        )
        return None

    transitioned = update_watchlist_candidate(
        candidate["setup_key"],
        {
            "status": "CONFIRMED",
            "candidate_data": candidate_data,
        },
        expected_status="WATCHING",
    )

    return signal if transitioned else None


def scan_symbol(symbol, watchlist_candidates=None):
    found = []
    emitted_setup_keys = set()
    higher_cache = {"candles": None}
    watchlist_candidates = watchlist_candidates or []

    for timeframe in TIMEFRAMES:
        try:
            candles = get_candles(symbol, timeframe, limit=CANDLE_LIMIT)
            if not candles or len(candles) < 100:
                continue

            # Resume persisted WATCHING setups before discovering new ones.
            for watch_candidate in watchlist_candidates:
                if watch_candidate.get("timeframe") != timeframe:
                    continue

                signal = process_watchlist_candidate(
                    watch_candidate,
                    candles,
                    higher_cache=higher_cache,
                )
                if signal is None:
                    continue

                setup_key = signal.get("setup_key")
                if not setup_key or setup_key in emitted_setup_keys:
                    continue
                if has_active_duplicate(signal) or has_recent_setup(signal):
                    continue

                found.append(signal)
                emitted_setup_keys.add(setup_key)

            # Keep the existing discovery path and its quality filters.
            for direction in ("LONG", "SHORT"):
                signal = build_signal(symbol, timeframe, direction, candles)
                if signal is None:
                    continue

                setup_key = signal.get("setup_key")
                if not setup_key or setup_key in emitted_setup_keys:
                    continue
                if has_active_duplicate(signal) or has_recent_setup(signal):
                    continue

                found.append(signal)
                emitted_setup_keys.add(setup_key)

        except Exception:
            logging.exception("Symbol scan failed: %s %s", symbol, timeframe)
            raise

    return found


def add_signal_candidate(signal):
    key = (
        signal["symbol"], signal["timeframe"],
        signal["direction"], signal.get("setup_key", "")
    )

    with CANDIDATE_LOCK:
        for index, existing in enumerate(signal_candidates):
            existing_key = (
                existing["symbol"], existing["timeframe"],
                existing["direction"], existing.get("setup_key", "")
            )
            if existing_key == key:
                if signal["score"] > existing["score"]:
                    signal_candidates[index] = signal
                    logging.info("CANDIDATE_UPDATED | %s", signal)
                return

        signal_candidates.append(signal)
        logging.info("CANDIDATE_CAPTURED | %s", signal)

def scan_market():
    """Merge fresh candidates across scans while discarding expired setups."""
    global signal_candidates

    active_contracts = get_contracts()
    if not active_contracts:
        logging.warning("No active contracts available; keeping previous candidate snapshot.")
        return False

    symbols = []
    for contract in active_contracts:
        raw_symbol = (
            contract if isinstance(contract, str)
            else contract.get("symbol", "") if isinstance(contract, dict)
            else ""
        )
        symbol = normalize_symbol(raw_symbol) if raw_symbol else None
        if symbol and symbol not in symbols:
            symbols.append(symbol)

    if not symbols:
        logging.warning("No valid symbols after contract normalization; keeping previous candidate snapshot.")
        return False

    # Expire old setups and load WATCHING rows once per market scan.
    try:
        expire_watchlist_candidates()
        watchlist_rows = get_active_watchlist()
    except Exception:
        logging.exception("Unable to load experimental watchlist.")
        return False

    watchlist_by_symbol = {}
    for item in watchlist_rows:
        item_symbol = item.get("symbol")
        if item_symbol:
            watchlist_by_symbol.setdefault(item_symbol, []).append(item)

    reset_diagnostics()
    logging.info(
        "Starting market scan: %s symbols | WATCHING setups: %s",
        len(symbols), len(watchlist_rows)
    )
    all_found = []
    failed_symbols = []

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {
            executor.submit(
                scan_symbol,
                symbol,
                watchlist_by_symbol.get(symbol, []),
            ): symbol
            for symbol in symbols
        }
        for future in as_completed(futures):
            symbol = futures[future]
            try:
                all_found.extend(future.result() or [])
            except Exception:
                failed_symbols.append(symbol)
                logging.exception("Scanner worker failed for %s.", symbol)

    report_diagnostics()

    if failed_symbols:
        logging.error(
            "Market scan incomplete (%s/%s failed); preserving previous candidate snapshot.",
            len(failed_symbols), len(symbols)
        )
        return False

    now_ms = int(time.time() * 1000)
    retention_ms = 600_000
    merged = {}

    with CANDIDATE_LOCK:
        previous_candidates = list(signal_candidates)

    # Keep only previous candidates whose 5m confirmation is still fresh.
    for signal in previous_candidates:
        try:
            confirmation = signal.get("confirmation") or {}
            close_time = int(confirmation.get("close_time") or 0)

            if not close_time or close_time > now_ms:
                continue
            if now_ms - close_time > retention_ms:
                continue

            key = (
                signal["symbol"], signal["timeframe"],
                signal["direction"], signal.get("setup_key", "")
            )
            merged[key] = signal
        except (KeyError, TypeError, ValueError):
            continue

    # Add newly discovered candidates; prefer the newer confirmation,
    # and use score as a tie-breaker for the same setup.
    for signal in all_found:
        try:
            confirmation = signal.get("confirmation") or {}
            close_time = int(confirmation.get("close_time") or 0)

            if not close_time or close_time > now_ms:
                continue
            if now_ms - close_time > retention_ms:
                continue

            key = (
                signal["symbol"], signal["timeframe"],
                signal["direction"], signal.get("setup_key", "")
            )
            existing = merged.get(key)

            if existing is None:
                merged[key] = signal
                logging.info("CANDIDATE_CAPTURED | %s", signal)
                continue

            old_close = int(
                (existing.get("confirmation") or {}).get("close_time") or 0
            )
            if (
                close_time > old_close
                or (
                    close_time == old_close
                    and int(signal.get("score", 0)) > int(existing.get("score", 0))
                )
            ):
                merged[key] = signal
                logging.info("CANDIDATE_UPDATED | %s", signal)

        except (KeyError, TypeError, ValueError):
            continue

    with CANDIDATE_LOCK:
        signal_candidates = list(merged.values())

    logging.info(
        "Market scan complete. New candidates: %s | retained fresh candidates: %s",
        len(all_found), len(signal_candidates)
    )
    return True

def reset_daily_signal_counter():
    global daily_signal_count, daily_date

    today = datetime.now(TEHRAN_TZ).date()
    today_text = today.isoformat()

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            conn.execute("""
                INSERT OR IGNORE INTO scanner_daily_stats (utc_date, sent_count)
                VALUES (?, 0)
            """, (today_text,))

            row = conn.execute(
                "SELECT sent_count FROM scanner_daily_stats WHERE utc_date = ?",
                (today_text,)
            ).fetchone()

            conn.commit()

    daily_date = today
    daily_signal_count = int(row[0]) if row else 0


def increment_daily_signal_count():
    global daily_signal_count, daily_date

    today = datetime.now(TEHRAN_TZ).date()
    today_text = today.isoformat()

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            conn.execute("""
                INSERT INTO scanner_daily_stats (utc_date, sent_count)
                VALUES (?, 1)
                ON CONFLICT(utc_date) DO UPDATE
                SET sent_count = sent_count + 1
            """, (today_text,))

            row = conn.execute(
                "SELECT sent_count FROM scanner_daily_stats WHERE utc_date = ?",
                (today_text,)
            ).fetchone()

            conn.commit()

    daily_date = today
    daily_signal_count = int(row[0]) if row else daily_signal_count + 1




def is_delivery_window(moment=None):
    local = moment.astimezone(TEHRAN_TZ) if moment else datetime.now(TEHRAN_TZ)
    return DELIVERY_START_HOUR <= local.hour < DELIVERY_END_HOUR


def current_selection_slot(moment=None):
    local = moment.astimezone(TEHRAN_TZ) if moment else datetime.now(TEHRAN_TZ)
    slot_minutes = max(1, SIGNAL_SELECTION_INTERVAL_SECONDS // 60)
    total_minutes = local.hour * 60 + local.minute
    slot_start = (total_minutes // slot_minutes) * slot_minutes
    return local.replace(
        hour=slot_start // 60, minute=slot_start % 60,
        second=0, microsecond=0
    )


def claim_selection_slot():
    """Claim each Tehran selection slot once, including across restarts."""
    local = datetime.now(TEHRAN_TZ)
    slot_minutes = max(1, SIGNAL_SELECTION_INTERVAL_SECONDS // 60)
    elapsed_minutes = (local.hour * 60 + local.minute) % slot_minutes
    if not is_delivery_window(local) or elapsed_minutes > 10:
        return False
    slot_key = current_selection_slot(local).isoformat()
    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            row = conn.execute(
                "SELECT state_value FROM scanner_schedule_state WHERE state_key='last_selection_slot'"
            ).fetchone()
            if row and row[0] == slot_key:
                return False
            conn.execute(
                "INSERT INTO scanner_schedule_state(state_key,state_value) VALUES('last_selection_slot',?) "
                "ON CONFLICT(state_key) DO UPDATE SET state_value=excluded.state_value",
                (slot_key,),
            )
            conn.commit()
    return True


def rolling_two_hour_signal_count(now=None):
    cutoff = (now or datetime.now(timezone.utc)) - timedelta(hours=2)
    cutoff_text = cutoff.astimezone(timezone.utc).isoformat()
    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            row = conn.execute("""
                SELECT COUNT(*)
                FROM notification_outbox
                WHERE event_type='INITIAL'
                  AND created_at >= ?
            """, (cutoff_text,)).fetchone()
    return int(row[0]) if row else 0


def rank_and_send_candidates():
    """Queue at most one fresh, best-scoring signal for this Tehran slot."""
    if not is_delivery_window():
        logging.info("Outside Tehran delivery hours; no signal selection/queueing.")
        return

    with CANDIDATE_LOCK:
        candidates = list(signal_candidates)
    if not candidates:
        logging.info("No valid candidates in this selection slot.")
        return

    candidates.sort(key=lambda item: int(item.get("score", 0)), reverse=True)
    send_candidates = []
    for signal in candidates:
        tier = signal.get("signal_tier", "SEND" if int(signal.get("score", 0)) >= MIN_SIGNAL_SCORE else "HISTORY")
        if tier in ("REVIEW", "HISTORY"):
            try:
                if not has_recent_setup(signal):
                    save_signal_audit(signal)
            except Exception:
                logging.exception("Could not save non-send signal audit.")
            continue
        if tier == "SEND" and int(signal.get("score", 0)) >= MIN_SIGNAL_SCORE:
            send_candidates.append(signal)

    for signal in send_candidates:
        try:
            if has_active_duplicate(signal) or has_recent_setup(signal):
                continue

            confirmation = signal.get("confirmation") or {}
            confirmation_close = int(confirmation.get("close_time") or 0)
            now_ms = int(time.time() * 1000)
            if not confirmation_close or now_ms - confirmation_close > 600_000 or confirmation_close > now_ms:
                continue

            latest = get_candles(signal["symbol"], CONFIRM_TIMEFRAME, limit=3)
            if not latest:
                continue
            latest_close_time = int(latest[-1]["time"]) + 300_000
            if latest_close_time > now_ms or now_ms - latest_close_time > 600_000:
                logging.info("Candidate rejected due to stale 5m market data: %s", signal["symbol"])
                continue
            current_price = float(latest[-1]["close"])
            entry = float(signal["entry"])
            atr_value = float(signal.get("atr") or 0)
            drift_limit = max(atr_value * 0.5, entry * 0.001)
            if abs(current_price - entry) > drift_limit:
                logging.info("Candidate rejected due to entry drift: %s", signal["symbol"])
                continue
            if signal["direction"] == "LONG" and current_price <= float(signal["stop_loss"]):
                continue
            if signal["direction"] == "SHORT" and current_price >= float(signal["stop_loss"]):
                continue

            if rolling_two_hour_signal_count() >= MAX_SIGNALS_PER_2H:
                logging.info("Rolling 2-hour signal cap reached (%s).", MAX_SIGNALS_PER_2H)
                return
            reset_daily_signal_counter()
            if daily_signal_count >= MAX_DAILY_SIGNALS:
                logging.info("Daily signal limit reached.")
                return

            signal_id = save_pending_vip_signal_and_enqueue(signal)
            logging.info(
                "Best signal queued: %s %s %s score=%s id=%s",
                signal["symbol"], signal["timeframe"], signal["direction"], signal["score"], signal_id
            )
            return
        except Exception:
            logging.exception("Candidate selection failed; trying next candidate.")

    logging.info("No candidate passed final freshness and duplicate checks.")




