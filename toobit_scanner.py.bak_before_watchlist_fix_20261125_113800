# Thread-safe diagnostics for candidate generation.
DIAGNOSTIC_LOCK = threading.Lock()
DIAGNOSTIC_COUNTS = {}


def record_diagnostic(timeframe, direction, reason):
    key = (timeframe, direction, reason)
    with DIAGNOSTIC_LOCK:
        DIAGNOSTIC_COUNTS[key] = DIAGNOSTIC_COUNTS.get(key, 0) + 1


def reset_diagnostics():
    with DIAGNOSTIC_LOCK:
        DIAGNOSTIC_COUNTS.clear()


def report_diagnostics():
    with DIAGNOSTIC_LOCK:
        snapshot = dict(DIAGNOSTIC_COUNTS)

    if not snapshot:
        logging.info("Diagnostics: no build results recorded.")
        return

    logging.info("========== SIGNAL DIAGNOSTICS ==========")
    for (timeframe, direction, reason), count in sorted(snapshot.items()):
        logging.info(
            "DIAGNOSTIC | %s | %s | %s: %s",
            timeframe, direction, reason, count
        )
    logging.info("========================================")


