def save_watchlist_candidate(candidate):
    """Persist a newly detected experimental setup without creating a VIP signal."""
    required = (
        "setup_key", "symbol", "timeframe", "direction",
        "strategy_type", "breakout_time", "breakout_price"
    )
    if not isinstance(candidate, dict) or any(
        key not in candidate for key in required
    ):
        raise ValueError("Incomplete watchlist candidate.")

    direction = str(candidate["direction"]).upper()
    strategy = str(candidate["strategy_type"]).upper()
    if direction not in ("LONG", "SHORT"):
        raise ValueError("Invalid watchlist direction.")
    if strategy not in ("TRENDLINE", "SUPPORT_RESISTANCE"):
        raise ValueError("Invalid watchlist strategy.")

    setup_key = str(candidate["setup_key"]).strip()
    symbol = str(candidate["symbol"]).strip().upper()
    timeframe = str(candidate["timeframe"]).strip()
    breakout_time = int(candidate["breakout_time"])
    breakout_price = float(candidate["breakout_price"])

    if not setup_key or not symbol or not timeframe:
        raise ValueError("Empty watchlist identity field.")
    if breakout_time <= 0 or not math.isfinite(breakout_price) or breakout_price <= 0:
        raise ValueError("Invalid breakout data.")

    now = datetime.now(timezone.utc).isoformat()
    payload = candidate.get("candidate_data", candidate)
    if not isinstance(payload, dict):
        raise ValueError("candidate_data must be a dictionary.")

    serialized = json.dumps(
        payload, ensure_ascii=False, separators=(",", ":"), allow_nan=False
    )

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            cursor = conn.execute("""
                INSERT OR IGNORE INTO signal_watchlist (
                    setup_key, symbol, timeframe, direction, strategy_type,
                    status, breakout_time, breakout_price, atr, volume_ratio,
                    candidate_data, last_checked_candle_time, checked_candles,
                    created_at, updated_at, expires_at
                ) VALUES (?, ?, ?, ?, ?, 'WATCHING', ?, ?, ?, ?, ?, ?, 0, ?, ?, ?)
            """, (
                setup_key, symbol, timeframe, direction, strategy,
                breakout_time, breakout_price,
                candidate.get("atr"),
                candidate.get("volume_ratio"),
                serialized,
                candidate.get("last_checked_candle_time"),
                now, now, candidate.get("expires_at")
            ))
            conn.commit()
            return cursor.rowcount == 1


def get_active_watchlist(limit=1000):
    """Load persisted WATCHING setups in creation order."""
    limit = max(1, min(int(limit), 5000))

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            conn.row_factory = sqlite3.Row
            rows = conn.execute("""
                SELECT * FROM signal_watchlist
                WHERE status = 'WATCHING'
                ORDER BY created_at ASC
                LIMIT ?
            """, (limit,)).fetchall()

    results = []
    for row in rows:
        item = dict(row)
        try:
            item["candidate_data"] = json.loads(item["candidate_data"])
        except (TypeError, ValueError, json.JSONDecodeError):
            logging.exception(
                "Invalid watchlist JSON for setup %s", item.get("setup_key")
            )
            continue
        results.append(item)

    return results


def update_watchlist_candidate(setup_key, updates, expected_status="WATCHING"):
    """Atomically update a watchlist row only from its expected state."""
    if not isinstance(updates, dict) or not updates:
        return False

    allowed = {
        "status", "atr", "volume_ratio", "candidate_data",
        "last_checked_candle_time", "checked_candles", "expires_at"
    }
    if not set(updates).issubset(allowed):
        raise ValueError("Unsupported watchlist update field.")

    valid_statuses = {"WATCHING", "CONFIRMED", "REJECTED", "EXPIRED"}
    expected_status = str(expected_status).upper()
    if expected_status not in valid_statuses:
        raise ValueError("Invalid expected watchlist status.")

    values = dict(updates)

    if "status" in values:
        values["status"] = str(values["status"]).upper()
        if values["status"] not in valid_statuses:
            raise ValueError("Invalid watchlist status.")

    if "candidate_data" in values:
        if not isinstance(values["candidate_data"], dict):
            raise ValueError("candidate_data must be a dictionary.")
        values["candidate_data"] = json.dumps(
            values["candidate_data"],
            ensure_ascii=False,
            separators=(",", ":"),
            allow_nan=False
        )

    values["updated_at"] = datetime.now(timezone.utc).isoformat()
    assignments = ", ".join(f"{key} = ?" for key in values)
    parameters = list(values.values()) + [
        str(setup_key), expected_status
    ]

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            cursor = conn.execute(
                f"""UPDATE signal_watchlist
                    SET {assignments}
                    WHERE setup_key = ? AND status = ?""",
                parameters
            )
            conn.commit()
            return cursor.rowcount == 1



def expire_watchlist_candidates(now_ms=None):
    """Expire WATCHING setups whose explicit expiry timestamp has passed."""
    if now_ms is None:
        now_ms = int(time.time() * 1000)

    now_text = datetime.now(timezone.utc).isoformat()

    with DB_LOCK:
        with sqlite3.connect(DATABASE_FILE) as conn:
            cursor = conn.execute("""
                UPDATE signal_watchlist
                SET status = 'EXPIRED', updated_at = ?
                WHERE status = 'WATCHING'
                  AND expires_at IS NOT NULL
                  AND expires_at <= ?
            """, (now_text, int(now_ms)))
            conn.commit()
            return cursor.rowcount


