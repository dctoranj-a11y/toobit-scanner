def make_trade_levels(candles, direction, atr_value, support_resistance, entry_price=None):
    if not candles or atr_value is None or atr_value <= 0:
        return None, "invalid_input"

    entry = float(entry_price if entry_price is not None else candles[-1]["close"])
    if entry <= 0:
        return None, "invalid_entry"

    recent = candles[-30:]
    recent_low = min(float(c["low"]) for c in recent)
    recent_high = max(float(c["high"]) for c in recent)

    if direction == "LONG":
        structural_stop = recent_low - atr_value * 0.15
        stop = min(structural_stop, entry - atr_value * STOP_ATR_MULTIPLIER)
        risk = entry - stop
        if risk <= 0:
            return None, "invalid_risk"

        resistance = support_resistance.get("resistance")
        if resistance is not None and resistance <= entry:
            resistance = None

        target1, target2, target3 = entry + risk * 2, entry + risk * 3, entry + risk * 4
        if resistance is not None and resistance < target1:
            return None, "resistance_blocks_tp1"

    elif direction == "SHORT":
        structural_stop = recent_high + atr_value * 0.15
        stop = max(structural_stop, entry + atr_value * STOP_ATR_MULTIPLIER)
        risk = stop - entry
        if risk <= 0:
            return None, "invalid_risk"

        support = support_resistance.get("support")
        if support is not None and support >= entry:
            support = None

        target1, target2, target3 = entry - risk * 2, entry - risk * 3, entry - risk * 4
        if support is not None and support > target1:
            logging.info(
                "TRADE_LEVEL_REJECT | SHORT | entry=%.10g | support=%.10g | "
                "stop=%.10g | tp1=%.10g | support_gap_pct=%.4f",
                entry, support, stop, target1,
                (support - target1) / entry * 100.0
            )
            return None, "support_blocks_tp1"

    else:
        return None, "invalid_direction"

    risk_percent = abs(entry - stop) / entry * 100.0
    if risk_percent <= 0:
        return None, "invalid_risk_percent"

    suggested_leverage = max(
        MIN_LEVERAGE,
        min(MAX_LEVERAGE, int(math.floor(2.0 / risk_percent)))
    )

    return {
        "entry": entry, "stop_loss": stop,
        "tp1": target1, "tp2": target2, "tp3": target3,
        "risk": risk, "risk_percent": risk_percent,
        "rr_tp1": abs(target1 - entry) / risk,
        "rr_tp2": abs(target2 - entry) / risk,
        "rr_tp3": abs(target3 - entry) / risk,
        "leverage": suggested_leverage,
        "margin_stop_loss_percent": risk_percent * suggested_leverage
    }, None

def fibonacci_confluence(price, levels, atr_value):
    if not levels or atr_value is None or atr_value <= 0:
        return []

    matches = []

    for name, level in levels.items():
        if abs(price - level) <= atr_value * 0.25:
            matches.append({
                "level": name,
                "price": level
            })

    return matches


def calculate_signal_score(
    breakout, retest, confirmation, indicator_data,
    higher_trend, fib_matches, direction
):
    # Maximum possible score = 98 (indicator model currently contributes 13).
    score = 0

    if breakout:
        score += 15
        if breakout.get("touches", 0) >= 4:
            score += 5
        if breakout.get("body_ratio", 0) >= 0.8:
            score += 5

    if retest:
        score += 15
    elif breakout and breakout.get("score", 0) >= 25:
        score += 7

    if confirmation:
        pattern = confirmation.get("pattern", "")
        if pattern in ("Bullish Engulfing", "Bearish Engulfing"):
            score += 20
        elif pattern in ("Hammer", "Shooting Star"):
            score += 15
        elif pattern in ("Inverted Hammer", "Hanging Man", "Bullish Pin Bar", "Bearish Pin Bar"):
            score += 12

    if indicator_data:
        score += min(13, int(indicator_data.get("score", 0)))

    if higher_trend == direction:
        score += 10
    elif higher_trend == "NEUTRAL":
        score += 5

    # Breakout and 5m confirmation volumes are distinct observations.
    breakout_volume = breakout.get("volume_ratio") if breakout else None
    confirm_volume = confirmation.get("volume_ratio") if confirmation else None
    if breakout_volume is not None:
        if breakout_volume >= 2.0:
            score += 6
        elif breakout_volume >= MIN_VOLUME_RATIO:
            score += 4
    if confirm_volume is not None:
        if confirm_volume >= 2.0:
            score += 4
        elif confirm_volume >= MIN_VOLUME_RATIO:
            score += 2

    if fib_matches:
        score += 5

    return min(100, int(score))




def create_trendline_watch_candidate(
    symbol, timeframe, direction, candles, breakout_index,
    line, breakout, atr_value
):
    """Build a persistent, timestamp-based trendline WATCHING candidate."""

    if not isinstance(line, dict) or not isinstance(breakout, dict):
        return None

    if direction not in ("LONG", "SHORT"):
        return None

    if timeframe not in ("15m", "1h"):
        return None

    if not (0 <= int(breakout_index) < len(candles)):
        return None

    points = []
    for point in line.get("points", []):
        index = int(point.get("index", -1))
        if not (0 <= index < len(candles)):
            return None

        points.append({
            "time": int(candles[index]["time"]),
            "price": float(point["price"]),
        })

    if len(points) < MIN_TRENDLINE_TOUCHES:
        return None

    breakout_candle = candles[int(breakout_index)]
    breakout_time = int(breakout_candle["time"])
    breakout_price = float(breakout.get("price", breakout_candle["close"]))

    interval_ms = {"15m": 900_000, "1h": 3_600_000}[timeframe]
    expires_at = breakout_time + interval_ms * (RETEST_MAX_BARS + 2)

    setup_key = (
        f"TRENDLINE|{symbol}|{timeframe}|{direction}|{breakout_time}"
    )

    candidate_data = {
        "strategy_type": "TRENDLINE",
        "line_points": points,
        "line_slope_per_bar": float(line["slope"]),
        "line_intercept_index_based": float(line["intercept"]),
        "breakout_index_at_detection": int(breakout_index),
        "breakout_candle_time": breakout_time,
        "breakout": {
            "price": breakout_price,
            "score": int(breakout.get("score", 0)),
            "volume_ratio": breakout.get("volume_ratio"),
            "body_ratio": breakout.get("body_ratio"),
        },
        "atr_at_detection": float(atr_value),
        "timeframe_interval_ms": interval_ms,
    }

    return {
        "setup_key": setup_key,
        "symbol": str(symbol).upper(),
        "timeframe": timeframe,
        "direction": direction,
        "strategy_type": "TRENDLINE",
        "breakout_time": breakout_time,
        "breakout_price": breakout_price,
        "atr": float(atr_value),
        "volume_ratio": breakout.get("volume_ratio"),
        "candidate_data": candidate_data,
        "expires_at": expires_at,
    }


def rebuild_watchlist_trendline(candidate_data, candles):
    """Rebuild a frozen trendline using stored pivot timestamps."""

    if not isinstance(candidate_data, dict) or not isinstance(candles, list):
        return None

    stored_points = candidate_data.get("line_points")
    if not isinstance(stored_points, list) or len(stored_points) < MIN_TRENDLINE_TOUCHES:
        return None

    time_to_index = {
        int(candle["time"]): index
        for index, candle in enumerate(candles)
        if isinstance(candle, dict) and "time" in candle
    }

    mapped_points = []
    for point in stored_points:
        try:
            timestamp = int(point["time"])
            price = float(point["price"])
            index = time_to_index.get(timestamp)

            if index is None or not math.isfinite(price) or price <= 0:
                return None

            mapped_points.append({"index": index, "price": price})
        except (KeyError, TypeError, ValueError, OverflowError):
            return None

    mapped_points.sort(key=lambda item: item["index"])

    if len({point["index"] for point in mapped_points}) != len(mapped_points):
        return None

    line = calculate_line(mapped_points)
    if line is None:
        return None

    line["points"] = mapped_points
    return line


def finalize_confirmed_setup(
    symbol, timeframe, direction, candles, line, breakout,
    retest, five_minute, prefix_atr, higher_cache
):
    """Apply the shared final validation and build a qualified signal."""
    interval_ms = {"15m": 900_000, "1h": 3_600_000}.get(timeframe)
    if interval_ms is None:
        record_diagnostic(timeframe, direction, "invalid_timeframe")
        return None

    confirmation_close_time = int(five_minute["close_time"])
    closed_main = [
        candle for candle in candles
        if int(candle["time"]) + interval_ms <= confirmation_close_time
    ]
    if len(closed_main) < 100:
        record_diagnostic(
            timeframe, direction, "insufficient_closed_main_candles"
        )
        return None

    indicators_now = calculate_indicators(closed_main)
    if not indicators_now or not indicators_now.get("atr"):
        record_diagnostic(timeframe, direction, "atr_unavailable")
        return None

    atr_value = float(indicators_now["atr"])
    indicator_data = analyze_indicators(closed_main, direction)
    if indicator_data is None:
        record_diagnostic(
            timeframe, direction, "directional_indicators_rejected"
        )
        return None

    if higher_cache.get("candles") is None:
        higher_cache["candles"] = get_candles(
            symbol, HIGHER_TIMEFRAME, limit=200
        )
    higher_all = higher_cache.get("candles")

    higher_closed = [
        candle for candle in (higher_all or [])
        if int(candle["time"]) + 14_400_000 <= confirmation_close_time
    ]
    higher_closed = contiguous_candle_suffix(
        higher_closed, HIGHER_TIMEFRAME
    )
    if len(higher_closed) < 60:
        record_diagnostic(
            timeframe, direction, "insufficient_higher_timeframe_history"
        )
        return None

    higher_trend = analyze_higher_trend(higher_closed)
    support_resistance = find_support_resistance(closed_main)

    levels, levels_rejection = make_trade_levels(
        closed_main,
        direction,
        atr_value,
        support_resistance,
        entry_price=five_minute["price"],
    )
    if levels is None:
        record_diagnostic(timeframe, direction, levels_rejection)
        return None
    if levels["rr_tp1"] < MIN_RR_TP1:
        record_diagnostic(
            timeframe, direction, "risk_reward_below_minimum"
        )
        return None

    fib_levels = fibonacci_levels(closed_main, direction=direction)
    fib_matches = fibonacci_confluence(
        levels["entry"], fib_levels, atr_value
    )

    fib_high = (
        fib_levels.get("0") if direction == "LONG"
        else fib_levels.get("1")
    )
    fib_low = (
        fib_levels.get("1") if direction == "LONG"
        else fib_levels.get("0")
    )
    fib_extensions = (
        fibonacci_extensions(fib_high, fib_low, direction)
        if fib_high is not None and fib_low is not None else {}
    )

    score = calculate_signal_score(
        breakout,
        retest,
        five_minute,
        indicator_data,
        higher_trend,
        fib_matches,
        direction,
    )
    if score < MIN_HISTORY_SCORE:
        record_diagnostic(
            timeframe, direction, "score_below_history_threshold"
        )
        return None

    tier = (
        "SEND" if score >= MIN_SIGNAL_SCORE
        else "REVIEW" if score >= MIN_REVIEW_SCORE
        else "HISTORY"
    )

    breakout_data = dict(breakout)
    breakout_data["candle_time"] = int(breakout_data["candle"]["time"])

    line_data = dict(line)
    line_data["points"] = [
        dict(point) for point in line_data.get("points", [])
    ]
    for point in line_data["points"]:
        idx = int(point["index"])
        if 0 <= idx < len(closed_main):
            point["time"] = int(closed_main[idx]["time"])

    line_data["chart_points"] = [
        {
            "time": int(closed_main[idx]["time"]),
            "price": line_price(line_data, idx),
        }
        for idx in range(
            int(line_data.get("start_index", 0)),
            len(closed_main),
        )
    ]

    retest_data = dict(retest) if retest else None
    if retest_data:
        retest_data["candle_time"] = int(
            retest_data["candle"]["time"]
        )

    record_diagnostic(timeframe, direction, "fully_qualified_setup")

    return {
        "symbol": symbol,
        "timeframe": timeframe,
        "direction": direction,
        "score": score,
        "signal_tier": tier,
        "entry": levels["entry"],
        "stop_loss": levels["stop_loss"],
        "tp1": levels["tp1"],
        "tp2": levels["tp2"],
        "tp3": levels["tp3"],
        "risk_percent": levels["risk_percent"],
        "rr_tp1": levels["rr_tp1"],
        "rr_tp2": levels["rr_tp2"],
        "rr_tp3": levels["rr_tp3"],
        "leverage": levels["leverage"],
        "margin_stop_loss_percent": levels["margin_stop_loss_percent"],
        "atr": atr_value,
        "rsi": indicator_data["rsi"],
        "volume_ratio": indicator_data["volume_ratio"],
        "trendline": line_data,
        "breakout": breakout_data,
        "retest": retest_data,
        "confirmation": five_minute,
        "higher_trend": higher_trend,
        "fibonacci": fib_levels,
        "fibonacci_extensions": fib_extensions,
        "fib_matches": fib_matches,
        "status": "READY",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "setup_key": (
            f"{symbol}|{timeframe}|{direction}|"
            f"{breakout_data['candle_time']}"
        ),
        "monitor_start_time": int(five_minute["time"]),
    }



def build_signal(symbol, timeframe, direction, candles):
    """Build the first fully qualified signal from recent closed-candle setups."""

    def reject(reason):
        record_diagnostic(timeframe, direction, reason)
        return None

    interval_ms = {"15m": 900_000, "1h": 3_600_000}.get(timeframe)
    if interval_ms is None or not candles:
        return reject("invalid_timeframe_or_empty_candles")

    candles = contiguous_candle_suffix(candles, timeframe)
    if len(candles) < 100:
        return reject("insufficient_main_candles")

    first_index = max(100, len(candles) - RETEST_MAX_BARS - 1)
    higher_cache = {"candles": None}

    # Examine recent setups chronologically. A failed final check must not
    # prevent later setups from being evaluated.
    for breakout_index in range(first_index, len(candles)):
        prefix = candles[:breakout_index]
        if len(prefix) < 70:
            continue

        prefix_atr = calculate_atr(prefix)
        if prefix_atr is None or prefix_atr <= 0:
            record_diagnostic(timeframe, direction, "invalid_prefix_atr")
            continue

        line = analyze_trendline(prefix, direction, prefix_atr, timeframe)
        if line is None:
            continue

        breakout = analyze_breakout(
            candles, line, direction, prefix_atr,
            index=breakout_index, timeframe=timeframe
        )
        if breakout is None:
            continue

        watch_candidate = create_trendline_watch_candidate(
            symbol=symbol,
            timeframe=timeframe,
            direction=direction,
            candles=candles,
            breakout_index=breakout_index,
            line=line,
            breakout=breakout,
            atr_value=prefix_atr,
        )
        if watch_candidate is not None:
            save_watchlist_candidate(watch_candidate)

        retest = None
        for retest_index in range(
            breakout_index + 1,
            min(len(candles), breakout_index + RETEST_MAX_BARS + 1)
        ):
            retest_atr = calculate_atr(candles[:retest_index + 1])
            if retest_atr is None or retest_atr <= 0:
                record_diagnostic(timeframe, direction, "invalid_retest_atr")
                continue

            candidate = analyze_retest(
                candles, line, direction, retest_atr, index=retest_index
            )
            if candidate:
                retest = candidate
                break

        if retest is None:
            # Immediate breakout is allowed only on the latest closed candle.
            if (
                breakout_index != len(candles) - 1
                or breakout.get("score", 0) < 25
            ):
                record_diagnostic(
                    timeframe, direction,
                    "retest_missing_and_immediate_breakout_rejected"
                )
                continue

            reference_index = breakout_index
            reference_candle = breakout["candle"]
        else:
            reference_index = int(retest["index"])
            reference_candle = retest["candle"]

        reference_close_time = int(reference_candle["time"]) + interval_ms
        line_at_reference = line_price(line, reference_index)

        five_minute = confirm_five_minute(
            symbol,
            direction,
            line_at_reference,
            prefix_atr,
            not_before_time=reference_close_time,
            not_after_time=reference_close_time + 600_000,
            timeframe=timeframe,
        )
        if five_minute is None:
            record_diagnostic(
                timeframe, direction, "five_minute_confirmation_missing"
            )
            continue

        signal = finalize_confirmed_setup(
            symbol=symbol,
            timeframe=timeframe,
            direction=direction,
            candles=candles,
            line=line,
            breakout=breakout,
            retest=retest,
            five_minute=five_minute,
            prefix_atr=prefix_atr,
            higher_cache=higher_cache,
        )
        if signal is not None:
            if watch_candidate is not None:
                update_watchlist_candidate(
                    watch_candidate["setup_key"],
                    {"status": "CONFIRMED"},
                    expected_status="WATCHING",
                )
            return signal
        continue

    record_diagnostic(timeframe, direction, "no_fully_qualified_setup")
    return None

