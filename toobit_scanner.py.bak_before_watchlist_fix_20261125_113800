def process_vip_signal(signal, candle):
    """Process one closed candle. SL has priority if SL and TP overlap."""
    if signal.get("status") != "ACTIVE":
        return []

    high, low = float(candle["high"]), float(candle["low"])
    direction = signal["direction"]
    entry = float(signal["entry"])
    stop = float(signal["stop_loss"])
    leverage = int(signal["leverage"])
    remaining = float(signal["remaining_fraction"])
    realized = float(signal["realized_roi"])
    candle_time = int(candle.get("time", 0))

    if direction == "LONG":
        stop_hit = low <= stop
        hits = [
            high >= float(signal["tp1"]),
            high >= float(signal["tp2"]),
            high >= float(signal["tp3"])
        ]
    else:
        stop_hit = high >= stop
        hits = [
            low <= float(signal["tp1"]),
            low <= float(signal["tp2"]),
            low <= float(signal["tp3"])
        ]

    if stop_hit:
        loss_roi = calculate_position_roi(direction, entry, stop, leverage)
        realized += remaining * loss_roi
        event = {
            "type": "SL",
            "price": stop,
            "realized_roi": realized,
            "leverage": leverage
        }
        signal.update({
            "status": "SL",
            "remaining_fraction": 0.0,
            "realized_roi": realized
        })

        enqueue_notification(
            signal["id"], event["type"],
            format_vip_result_message(signal, event)
        )

        update_vip_signal(
            signal["id"],
            status="SL",
            remaining_fraction=0.0,
            realized_roi=realized,
            last_checked_candle_time=candle_time
        )
        return [event]

    targets = [
        ("TP1", "tp1", "tp1_done", TP1_CLOSE_FRACTION),
        ("TP2", "tp2", "tp2_done", TP2_CLOSE_FRACTION),
        ("TP3", "tp3", "tp3_done", None)
    ]

    events = []
    updates = {"last_checked_candle_time": candle_time}

    for index, (event_type, price_key, done_key, close_fraction) in enumerate(targets):
        if not hits[index] or signal.get(done_key):
            continue
        if remaining <= 0:
            break

        fraction = remaining if close_fraction is None else min(close_fraction, remaining)
        target_price = float(signal[price_key])
        profit_roi = calculate_position_roi(
            direction, entry, target_price, leverage
        )
        realized += fraction * profit_roi
        remaining = max(0.0, remaining - fraction)

        signal[done_key] = 1
        signal["remaining_fraction"] = remaining
        signal["realized_roi"] = realized
        updates[done_key] = 1

        event = {
            "type": event_type,
            "price": target_price,
            "closed_fraction": fraction,
            "realized_roi": realized,
            "leverage": leverage
        }
        events.append(event)

        if event_type == "TP3":
            signal["status"] = "TP3"
            updates["status"] = "TP3"

    if events:
        updates["remaining_fraction"] = remaining
        updates["realized_roi"] = realized

        # Queue every event before committing candle progress.
        for event in events:
            enqueue_notification(
                signal["id"], event["type"],
                format_vip_result_message(signal, event)
            )

    update_vip_signal(signal["id"], **updates)
    return events


def monitor_vip_signals():
    """Monitor closed 5m candles after entry and never bridge missing candles."""
    active_signals = get_active_vip_signals()
    now = datetime.now(timezone.utc)
    now_ms = int(now.timestamp() * 1000)
    step = 300_000

    for signal in active_signals:
        try:
            created = datetime.fromisoformat(signal["created_at"])
            if created.tzinfo is None:
                created = created.replace(tzinfo=timezone.utc)
            created_ms = int(created.timestamp() * 1000)
            expiry_ms = created_ms + SIGNAL_MAX_AGE_HOURS * 3_600_000

            stored_last_checked = int(
                signal.get("last_checked_candle_time")
                or signal.get("monitor_start_time")
                or 0
            )
            # New records store the 5m confirmation candle open, normally
            # within ten minutes before creation. Older records may store a
            # 15m/1h candle open; in that case skip the partially elapsed 5m bar.
            if stored_last_checked and 0 <= created_ms - stored_last_checked <= 600_000:
                last_checked = stored_last_checked
            else:
                last_checked = max(stored_last_checked, (created_ms // step) * step)

            candles = get_candles(signal["symbol"], CONFIRM_TIMEFRAME, limit=1000)
            processed_last = last_checked
            data_gap = False
            eligible = [
                candle for candle in (candles or [])
                if int(candle["time"]) > last_checked
                and int(candle["time"]) + step <= expiry_ms
            ]

            for candle in eligible:
                candle_time = int(candle["time"])
                expected_time = processed_last + step
                if candle_time != expected_time:
                    logging.error(
                        "5m data gap for active signal %s: expected candle %s, received %s; monitoring paused.",
                        signal["id"], expected_time, candle_time
                    )
                    data_gap = True
                    break

                process_vip_signal(signal, candle)
                processed_last = candle_time
                if signal.get("status") != "ACTIVE":
                    break

            if signal.get("status") != "ACTIVE" or now_ms < expiry_ms:
                continue

            # Expiry is finalized only if every expected closed 5m candle up to
            # the expiry boundary was available and processed in sequence.
            expected_last_open = ((expiry_ms - step) // step) * step
            if data_gap or processed_last < expected_last_open:
                logging.warning(
                    "Signal %s reached expiry time but 5m history is incomplete; keeping it active until data is complete.",
                    signal["id"]
                )
                continue

            mark_candle = next(
                (candle for candle in reversed(candles or [])
                 if int(candle["time"]) == expected_last_open),
                None
            )
            if mark_candle is None:
                logging.warning("No exact expiry-boundary candle for signal %s; keeping it active.", signal["id"])
                continue

            exit_price = float(mark_candle["close"])
            remaining = float(signal["remaining_fraction"])
            realized = float(signal["realized_roi"])
            realized += remaining * calculate_position_roi(
                signal["direction"], float(signal["entry"]),
                exit_price, int(signal["leverage"])
            )
            event = {
                "type": "EXPIRED", "price": exit_price,
                "realized_roi": realized,
                "leverage": int(signal["leverage"]),
            }
            enqueue_notification(
                signal["id"], "EXPIRED",
                format_vip_result_message(signal, event)
            )
            update_vip_signal(
                signal["id"], status="EXPIRED", remaining_fraction=0.0,
                realized_roi=realized,
                last_checked_candle_time=int(mark_candle["time"]),
            )
            signal.update({"status": "EXPIRED", "remaining_fraction": 0.0, "realized_roi": realized})

        except Exception:
            logging.exception("Signal monitoring failed for %s", signal.get("symbol", "UNKNOWN"))


