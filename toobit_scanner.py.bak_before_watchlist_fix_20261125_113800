def calculate_position_roi(direction, entry, exit_price, leverage):
    if entry <= 0:
        return 0.0

    if direction == "LONG":
        price_change = (exit_price - entry) / entry
    else:
        price_change = (entry - exit_price) / entry

    return price_change * leverage * 100



